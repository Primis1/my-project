FROM n8nio/n8n:2.7.4

USER root

# Install pdf-lib globally, then symlink it into a path the task runner can resolve
RUN npm install -g pdf-lib && \
    mkdir -p /usr/local/lib/node_modules/n8n/node_modules/.pnpm/node_modules && \
    ln -s $(npm root -g)/pdf-lib \
    /usr/local/lib/node_modules/n8n/node_modules/.pnpm/node_modules/pdf-lib

# Copy task runner config
COPY n8n-task-runners.json /etc/n8n-task-runners.json

USER node